# Copy to .env before running Bun scripts. Dotenvx injects these values.
POSTGRES_PORT=5432
DATABASE_URL=postgres://starter:starter@localhost:5432/starter
# Integration tests use local PostgreSQL and clean up their own rows.
TEST_DATABASE_URL=postgres://starter:starter@localhost:5432/starter
# Optional direct Neon URL for migrations. Local development can leave empty.
DATABASE_MIGRATION_URL=
API_HOST=0.0.0.0
API_PORT=3001
API_ORIGIN=http://localhost:3001
# Optional app-server-only route to API, for private service networks.
API_INTERNAL_ORIGIN=
VITE_API_ORIGIN=http://localhost:3001
APP_ORIGIN=http://localhost:3000
VITE_APP_ORIGIN=http://localhost:3000
VITE_WEB_ORIGIN=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Local-only starter secret. Generate a new 32+ character value for deployment.
BETTER_AUTH_SECRET=local-only-better-auth-secret-1234567890
# Production with app.example.com + api.example.com: set shared parent domain.
AUTH_COOKIE_DOMAIN=
# Optional seed target: register account first, then set its email.
SEED_USER_EMAIL=
# Optional Upstash Redis credentials. Leave both blank for PostgreSQL-only setup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_NAMESPACE=groundwork:dev
# Optional Stripe billing. Configure all four together; use test-mode values locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_ONE_TIME_PRICE_ID=
