{
  "name": "@starter/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "start": "bun dist/server.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check src",
    "test": "bun test src"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@elysia/cors": "1.4.2",
    "@starter/billing": "workspace:*",
    "@starter/cache": "workspace:*",
    "@starter/db": "workspace:*",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@elysia/eden": "1.4.10",
    "@types/bun": "1.4.2"
  }
}
